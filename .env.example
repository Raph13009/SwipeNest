# Save this file as `.env` at the repo root (SwipeNest/.env), then restart servers.
# Do NOT wrap values in quotes.

# Google AI Studio free key → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (default gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Mapbox public token → https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase (project SwipeNest)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
